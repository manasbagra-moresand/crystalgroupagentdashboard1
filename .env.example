# Zoom Server-to-Server OAuth app credentials (Zoom App Marketplace -> Develop -> Build App -> Server-to-Server OAuth).
# The app needs Zoom Phone scopes for reading users, call queues, call queue membership and call logs,
# plus the core user presence scope. As of writing that's roughly:
#   phone:read:list_users:admin
#   phone:read:list_call_queues:admin
#   phone:read:call_queue_member:admin  (Call Queue Members)
#   phone:read:list_call_logs:admin     (Call Logs - note the plural/list_ form; the older
#                                        phone:read:call_log:admin is NOT what Zoom asks for)
#   user:read:presence_status:admin     (or the closest current equivalent under Zoom's granular scopes)
# Zoom periodically renames granular scopes - if a request comes back 403, check the exact scope name
# for that endpoint in Zoom's API reference and add it to the app.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Cookie-session signing secret. Set this to a long random string in any real deployment.
SESSION_SECRET=change-me-to-a-long-random-string

# Business unit(s) the dashboard covers, comma-separated. Matched against each Zoom phone
# user's `department` OR `cost_center` - Zoom phone users have no "group" field, and on a
# real account the two fields disagree for the odd person, so either one matching counts.
# Trimmed and case-insensitive, but exact after that: "Crystal UK" won't match "Crystal US".
# Leave empty to include every phone user on the account.
DEPARTMENTS=Crystal UK

# How often (ms) the server polls Zoom for live status. Each poll costs roughly
# (queues in scope + agents + 1) Zoom requests, so keep this sane relative to Zoom's
# per-second rate limit. The dashboard warns you if a poll takes longer than the interval.
POLL_INTERVAL_MS=15000

# Max Zoom requests in flight at once during a poll. The brake for Zoom's rate limit.
ZOOM_CONCURRENCY=8

# How often (ms) to re-sweep every call queue on the account looking for queues that contain
# agents from DEPARTMENTS. Between sweeps only those queues are polled. Queue membership
# changes rarely; opt-in/opt-out status is read fresh on every poll either way.
QUEUE_DISCOVERY_MS=600000

# Optional: restrict to specific call queues by name instead of discovering them from
# DEPARTMENTS. Comma-separated, exact names.
# QUEUE_NAMES=

# HTTP port the app listens on.
PORT=3000

# Wall-clock zone for every date and time the dashboard records and displays. Defaults to
# Europe/London, so times read as BST in summer and GMT in winter regardless of the
# server's own zone. Use a full IANA zone name, not a fixed offset like UTC+1.
TIME_ZONE = Europe/London

# How long the phone-user roster and call-queue list are reused between polls (ms). These
# change when someone joins/leaves, not second to second, and re-listing them costs ~4.7s
# per tick on this account -- far more than the live signals. Default 10 minutes.
ROSTER_TTL_MS = 600000

# How long an agent's call log (attended/abandoned counts) is reused (ms). The most
# expensive part of a poll (~10.3s for 60 agents). Refreshes are spread across ticks rather
# than all expiring together. Default 60 seconds.
CALL_LOG_TTL_MS = 60000

# Break allowance per opt-out reason, as "Reason:minutes" pairs. Shown as a countdown in
# front of the agent's name, which keeps counting once it passes zero; a reason not listed
# here gets no timer. Break is a short comfort break, Meal is a lunch.
#
# "Unspecified" carries the longer Meal-length allowance deliberately: Zoom's API never
# reveals which reason an agent picked, so every on-break agent lands there and something
# has to be assumed. Assuming 15 would flag everyone genuinely at lunch as over at the
# 15-minute mark -- a wall of false red. Erring long misses a short-break overrun instead,
# which is the cheaper mistake. Swap to 15 if you'd rather trade the other way.
BREAK_ALLOWANCES = Break:15,Meal:30,Unspecified:30
